{
  "name": "alpine",
  "private": true,
  "description": "Alpine: AI voice interview practice. One backend (API + voice models) and one frontend.",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:backend\" \"npm:frontend\"",
    "backend": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --port 8100",
    "frontend": "npm --prefix frontend run dev -- --port 5173",
    "test": "cd backend && .venv\\Scripts\\python -m pytest -q",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
