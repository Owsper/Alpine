LLM_BASE_URL=https://relay.crunchman.info/v1
LLM_API_KEY=
# Asked in parallel; the first valid JSON answer wins
LLM_MODELS=zai-org/GLM-5.3-Flash,nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B
LLM_TIMEOUT_S=40
# Cached demo-company research and a rule-based grader fallback, so a provider outage never stops the demo
DEMO_MODE=true
GRADER_RUNS=3
DATABASE_PATH=interviewverse.db
CORS_ORIGINS=http://localhost:5173,https://localhost:5174
# Whisper large-v3 (GPU) + Kokoro-82M (CPU). Set false on machines without the models.
VOICE_ENABLED=true
ASR_ENGINE=whisper
TTS_ENGINE=kokoro
KOKORO_VOICE=am_michael
